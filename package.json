{
  "name": "dootty",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:windows": "node scripts/build-windows.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "check:security": "npm run check:translations && npm audit --audit-level=moderate",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "i18next": "26.7.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "packageManager": "npm@12.2.1",
  "license": "MIT",
  "author": "DooSys",
  "homepage": "https://github.com/DooSys"
}
